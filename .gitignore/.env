# Copy this file to .env and fill in real values before running the server.

# Random long string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the HTTP + WebSocket server listens on
PORT=3000

# Comma-separated list of origins allowed to connect (your frontend's URL)
CORS_ORIGIN=http://localhost:5173

# Username(s) that get promoted to "admin" automatically on first registration.
# Comma-separated, case-insensitive. Leave blank to disable.
SEED_ADMIN_USERNAMES=admin
